{
  "$ref": "#/definitions/evenements",
  "definitions": {
    "evenements": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mathematiques",
              "statistiques",
              "informatique",
              "ia-data"
            ]
          }
        },
        "format": {
          "type": "string",
          "enum": [
            "presentiel",
            "en-ligne",
            "hybride"
          ]
        },
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "default": "Cameroun"
        },
        "startDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "endDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "organizer": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "registrationDeadline": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "a-venir",
            "en-cours",
            "passe"
          ],
          "default": "a-venir"
        },
        "source": {
          "type": "string"
        },
        "verifiedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "why": {
          "type": "string"
        },
        "cover": {
          "type": "string"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "domains",
        "format",
        "city",
        "startDate",
        "organizer",
        "url",
        "source",
        "verifiedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}