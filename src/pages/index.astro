---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import SectionHeading from '@components/SectionHeading.astro';
import ExpertiseCard from '@components/ExpertiseCard.astro';
import ProjectCard from '@components/ProjectCard.astro';
import EventCard from '@components/EventCard.astro';
import TalentCard from '@components/TalentCard.astro';
import PostCard from '@components/PostCard.astro';
import CTA from '@components/CTA.astro';
import Flag from '@components/Flag.astro';

import site from '@data/site.json';
import expertiseData from '@data/expertise.json';

// -------- Projets --------
const projets = await getCollection('projets');
const atlas = projets.find((p) => p.slug === 'atlas');
const projetsSecondaires = projets
  .filter((p) => !p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

// -------- Événements --------
const evenements = await getCollection('evenements');
const evenementsTries = evenements.sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()
);
const prochainsEvenements = evenementsTries
  .filter((e) => e.data.status !== 'passe')
  .slice(0, 3);
const derniersEvenements = evenementsTries
  .filter((e) => e.data.status === 'passe')
  .slice(0, 3);
const evenementsAffiches =
  prochainsEvenements.length > 0 ? prochainsEvenements : derniersEvenements;

// -------- Talents --------
const talents = (await getCollection('talents'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

// -------- Journal --------
const articles = (await getCollection('journal', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

// -------- Compteurs (pour chiffres clés) --------
const stats = {
  projets: projets.length,
  talents: (await getCollection('talents')).length,
  domaines: expertiseData.domains.length
};

// -------- JSON-LD homepage --------
const homeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.description,
  inLanguage: 'fr-FR',
  publisher: {
    '@id': `${site.url}/#organization`
  }
};
---
<BaseLayout
  title="Gemula — Collectif étudiant d'innovation technologique à Douala"
  description="Gemula conçoit des solutions data, IA, logiciel et design depuis Douala. Apprendre, expérimenter, construire, publier, collaborer."
  jsonLd={homeJsonLd}
>
  <!-- ================= 01 · HERO ================= -->
  <Hero
    eyebrow="Collectif étudiant · Douala · Cameroun"
    title="Là où le talent devient un impact."
    subtitle="Gemula est un collectif étudiant d'innovation technologique. Nous apprenons, expérimentons, construisons, publions et collaborons autour de la data, de l'IA, du logiciel et du design."
    primaryCta={{ href: '/projet', label: 'Découvrir Atlas' }}
    secondaryCta={{ href: '/collaborer', label: 'Collaborer avec nous' }}
  />

  <!-- ================= 02 · GEMULA EN QUELQUES MOTS ================= -->
  <section class="container-g py-20 md:py-28 border-t border-gemula-black/[0.06]">
    <div class="grid lg:grid-cols-12 gap-12">
      <div class="lg:col-span-4 reveal">
        <div class="flex items-center gap-3 mb-6">
          <Flag size="sm" />
          <span class="eyebrow">Le collectif</span>
        </div>
      </div>

      <div class="lg:col-span-8 reveal">
        <p class="font-display text-xl md:text-3xl font-semibold leading-snug tracking-tightest text-balance">
          Depuis Douala, Gemula forme une génération d'étudiants qui ne se contentent pas d'apprendre : ils livrent des solutions concrètes, documentées et mesurables pour des entreprises, des institutions et des porteurs de projets.
        </p>

        <div class="mt-12 grid grid-cols-3 gap-8 max-w-xl">
          <div>
            <span class="font-display text-3xl md:text-4xl font-bold text-gemula-orange">
              {String(stats.projets).padStart(2, '0')}
            </span>
            <p class="mt-2 text-sm text-gemula-grey">Projets construits</p>
          </div>
          <div>
            <span class="font-display text-3xl md:text-4xl font-bold text-gemula-orange">
              {String(stats.talents).padStart(2, '0')}
            </span>
            <p class="mt-2 text-sm text-gemula-grey">Talents actifs</p>
          </div>
          <div>
            <span class="font-display text-3xl md:text-4xl font-bold text-gemula-orange">
              {String(stats.domaines).padStart(2, '0')}
            </span>
            <p class="mt-2 text-sm text-gemula-grey">Domaines couverts</p>
          </div>
        </div>

        <p class="mt-12 text-base text-gemula-grey leading-relaxed max-w-2xl">
          Le collectif est né d'une conviction simple : l'Afrique de demain a besoin de ses propres ingénieurs, data scientists et designers. Nous construisons cet avenir depuis Douala, avec rigueur scientifique et exécution produit.
        </p>
      </div>
    </div>
  </section>

  <!-- ================= 03 · EXPERTISE ================= -->
  <section class="container-g py-20 md:py-28 border-t border-gemula-black/[0.06]">
    <SectionHeading
      eyebrow="Expertise"
      title="Cinq domaines, une même exigence."
      description="De la donnée à l'interface, Gemula rassemble des compétences complémentaires pour explorer, prototyper et construire des solutions numériques utiles."
      link={{ href: '/expertise', label: 'Voir en détail' }}
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {expertiseData.domains.slice(0, 5).map((domain) => (
        <ExpertiseCard domain={domain} />
      ))}

      <!-- Carte bonus : lien vers tous les projets -->
      <article class="card card-hover reveal h-full flex flex-col bg-gemula-black text-white border-gemula-black">
        <div class="flex items-start justify-between mb-6">
          <span class="text-xs font-semibold tracking-kicker text-gemula-orange">
            06
          </span>
          <span class="material-symbols-outlined text-2xl text-gemula-orange" aria-hidden="true">
            arrow_outward
          </span>
        </div>
        <h3 class="font-display text-xl font-semibold mb-3">
          Et aussi
        </h3>
        <p class="text-sm text-white/70 leading-relaxed flex-grow">
          Exploration, prototypage, recherche appliquée et expérimentations internes menées par les membres du collectif.
        </p>
        <ul class="mt-6 flex flex-wrap gap-2">
          <li class="inline-flex items-center rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-medium text-white/80">
            Recherche
          </li>
          <li class="inline-flex items-center rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-medium text-white/80">
            Prototypage
          </li>
        </ul>
      </article>
    </div>
  </section>

  <!-- ================= 04 · PROJET PHARE : ATLAS ================= -->
  {atlas && (
    <section class="container-g py-20 md:py-28 border-t border-gemula-black/[0.06]">
      <SectionHeading
        eyebrow="Projet phare"
        title="Dataikos Atlas"
        description="La gestion opérationnelle complète des PME camerounaises, en local, sans cloud."
      />

      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <div class="lg:col-span-7 reveal">
          <div class="space-y-8">
            <div>
              <span class="eyebrow block mb-3">Problème</span>
              <p class="text-base text-gemula-black leading-relaxed">
                {atlas.data.problem}
              </p>
            </div>

            <div>
              <span class="eyebrow block mb-3">Contexte</span>
              <p class="text-base text-gemula-grey leading-relaxed">
                {atlas.data.context}
              </p>
            </div>

            <div>
              <span class="eyebrow block mb-3">Solution</span>
              <p class="text-base text-gemula-grey leading-relaxed">
                {atlas.data.solution}
              </p>
            </div>
          </div>

          <div class="mt-10">
            <span class="eyebrow block mb-4">Technologies</span>
            <ul class="flex flex-wrap gap-2">
              {atlas.data.stack.map((tech) => (
                <li class="tag">{tech}</li>
              ))}
            </ul>
          </div>

          <div class="mt-10 flex flex-wrap gap-3">
            <a href="/projet" class="btn-primary">
              Voir l'étude de cas
              <span class="material-symbols-outlined text-[1.1em]" aria-hidden="true">
                arrow_forward
              </span>
            </a>
            <a href="/projets" class="btn-ghost">
              Toutes les réalisations
            </a>
          </div>
        </div>

        <!-- Aperçu visuel Atlas -->
        <div class="lg:col-span-5 reveal">
          <div class="rounded-2xl overflow-hidden border border-gemula-black/[0.08] bg-white aspect-[4/3]">
            {atlas.data.cover ? (
              <img
                src={atlas.data.cover}
                alt={`Interface de ${atlas.data.title}`}
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center bg-gemula-sand">
                <Flag size="lg" />
              </div>
            )}
          </div>

          <div class="mt-6 grid grid-cols-2 gap-3">
            {atlas.data.features.slice(0, 4).map((feature) => (
              <div class="rounded-xl border border-gemula-black/[0.08] bg-white p-4">
                <p class="text-xs text-gemula-grey leading-snug">
                  {feature}
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Autres réalisations -->
      {projetsSecondaires.length > 0 && (
        <div class="mt-20 pt-16 border-t border-gemula-black/[0.06]">
          <div class="flex items-end justify-between mb-10">
            <div>
              <span class="eyebrow block mb-3">Autres réalisations</span>
              <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tightest">
                Ce que nous construisons aussi.
              </h3>
            </div>
            <a
              href="/projets"
              class="hidden md:inline-flex items-center gap-2 text-sm font-medium text-gemula-grey hover:text-gemula-orange transition-colors"
            >
              Tous les projets
              <span class="material-symbols-outlined text-[1.1em]" aria-hidden="true">
                arrow_forward
              </span>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            {projetsSecondaires.map((projet) => (
              <ProjectCard project={projet} />
            ))}
          </div>
        </div>
      )}
    </section>
  )}

  <!-- ================= 05 · AGENDA SCIENTIFIQUE ================= -->
  <section class="container-g py-20 md:py-28 border-t border-gemula-black/[0.06]">
    <SectionHeading
      eyebrow="Agenda scientifique"
      title="Les rendez-vous qui font avancer la science."
      description="Conférences, colloques, workshops et écoles scientifiques liés aux mathématiques, statistiques, informatique, data science et intelligence artificielle au Cameroun."
      link={{ href: '/agenda-scientifique', label: 'Agenda complet' }}
    />

    {evenementsAffiches.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {evenementsAffiches.map((event) => (
          <EventCard event={event} />
        ))}
      </div>
    ) : (
      <div class="rounded-2xl border border-dashed border-gemula-black/15 bg-white/60 p-10 text-center">
        <p class="text-gemula-grey">
          L'agenda sera mis à jour prochainement avec les prochains rendez-vous scientifiques.
        </p>
      </div>
    )}

    <p class="mt-8 text-xs text-gemula-grey leading-relaxed max-w-2xl">
      Gemula recense ces événements à titre informatif. Les dates et modalités peuvent évoluer ; consultez la source officielle avant de vous inscrire.
    </p>
  </section>

  <!-- ================= 06 · TALENTS ================= -->
  <section class="container-g py-20 md:py-28 border-t border-gemula-black/[0.06]">
    <SectionHeading
      eyebrow="Talents"
      title="Les visages derrière les projets."
      description="Une communauté de profils complémentaires : data scientists, développeurs, designers, électrotechniciens. Découvrez qui construit Gemula."
      link={{ href: '/talents', label: 'Tous les talents' }}
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      {talents.map((talent) => (
        <TalentCard talent={talent} />
      ))}
    </div>
  </section>

  <!-- ================= 07 · JOURNAL ================= -->
  <section class="container-g py-20 md:py-28 border-t border-gemula-black/[0.06]">
    <SectionHeading
      eyebrow="Journal"
      title="Ce que nous apprenons, publions et vivons."
      description="Stages, compétitions, certifications, projets et vie du collectif. Le journal de Gemula."
      link={{ href: '/journal', label: 'Tout le journal' }}
    />

    {articles.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {articles.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <div class="rounded-2xl border border-dashed border-gemula-black/15 bg-white/60 p-10 text-center">
        <p class="text-gemula-grey">
          Les premiers articles du journal arrivent bientôt.
        </p>
      </div>
    )}
  </section>

  <!-- ================= 08 · CTA COLLABORER ================= -->
  <CTA
    eyebrow="Collaborer"
    title="Vous avez un problème ? Gemula peut le transformer en solution."
    description="Entreprises, institutions, chercheurs, porteurs de projets : proposons ensemble un prototype, une analyse ou un produit."
    primaryCta={{ href: '/collaborer', label: 'Proposer un projet' }}
    secondaryCta={{ href: '/expertise', label: 'Voir nos expertises' }}
    dark={true}
  />
</BaseLayout>