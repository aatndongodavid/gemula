---
import { getCollection } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import TalentCard from '@components/TalentCard.astro';
import CTA from '@components/CTA.astro';
import formations from '@data/formations.json';

const talents = (await getCollection('talents')).sort(
  (a, b) => a.data.order - b.data.order
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Talents de Gemula',
  itemListElement: talents.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Person',
      name: t.data.name,
      jobTitle: t.data.role,
      affiliation: 'Gemula',
      ...(t.data.linkedin ? { sameAs: t.data.linkedin } : {})
    }
  }))
};
---
<PageLayout
  title="Équipe"
  description="Les membres de Gemula : data scientists, analystes, ingénieurs IA, développeurs et électrotechniciennes. Les profils qui forment vos équipes et construisent nos projets."
  eyebrow="Le collectif"
  breadcrumb={[
    { href: '/', label: 'Accueil' },
    { label: 'Équipe' }
  ]}
  jsonLd={jsonLd}
>
  <!-- Intro -->
  <section class="container-g pb-16 md:pb-20">
    <div class="max-w-3xl">
      <p class="text-lg md:text-xl text-gemula-grey leading-relaxed">
        Gemula rassemble des profils complémentaires : data, IA, développement, design et ingénierie. Les membres marqués comme formateurs interviennent dans nos <a href="/formations#formateurs" class="font-semibold text-gemula-black underline decoration-gemula-orange decoration-2 underline-offset-4">formations pour entreprises</a>.
      </p>
    </div>
  </section>

  <!-- Grille talents -->
  <section class="container-g pb-20 md:pb-28">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {talents.map((talent) => (
        <TalentCard talent={talent} teaches={formations.formateurs[talent.slug as keyof typeof formations.formateurs]} />
      ))}
    </div>
  </section>

  <!-- Rejoindre -->
  <section class="container-g py-20 md:py-28 border-t border-gemula-silver">
    <SectionHeading
      eyebrow="Rejoindre Gemula"
      title="Rejoindre Gemula"
      description="Nous étudions les candidatures de profils data, IA, développement, design et ingénierie lorsque des responsabilités sont disponibles."
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl">
      {[
        {
          title: 'Profils techniques',
          desc: 'Data, IA, développement web et logiciel, data engineering.'
        },
        {
          title: 'Profils créatifs',
          desc: 'Design UI/UX, branding, communication digitale, motion.'
        },
        {
          title: 'Profils ingénierie',
          desc: 'Électrotechnique, systèmes embarqués, IoT.'
        }
      ].map((profil) => (
        <div class="card">
          <h3 class="font-display text-lg font-semibold mb-3">
            {profil.title}
          </h3>
          <p class="text-sm text-gemula-grey leading-relaxed">
            {profil.desc}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-10">
      <a href="/collaborer#rejoindre" class="btn-primary">
        Candidater
      </a>
    </div>
  </section>

  <CTA
    eyebrow="Collaboration"
    title="Besoin d'un profil précis ?"
    description="Nous mettons en relation entreprises et talents du collectif pour des stages, missions ou collaborations longues."
    primaryCta={{ href: '/collaborer', label: 'Nous contacter' }}
    dark={false}
  />
</PageLayout>