---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import site from '@data/site.json';

const whatsappUrl = site.community?.whatsappUrl ?? '';

const espaces = [
  { key: 'Learn',   fr: 'Apprendre',  icon: 'school',       desc: 'Ateliers gratuits, tutoriels et entraide entre membres.' },
  { key: 'Explore', fr: 'Découvrir',  icon: 'explore',      desc: 'Veille, conférences et opportunités partagées.' },
  { key: 'Build',   fr: 'Contribuer', icon: 'construction', desc: 'Mini-projets et missions ponctuelles encadrées.' },
  { key: 'Connect', fr: 'Réseauter',  icon: 'groups',       desc: 'Rencontres et partage de compétences.' }
];

const inputClass = 'field';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Gemula Community',
  url: `${site.url}/communaute`,
  inLanguage: 'fr-FR',
  isPartOf: { '@id': `${site.url}/#organization` }
};
---
<BaseLayout
  title="Gemula Community · Gemula"
  description="Une communauté ouverte et gratuite pour apprendre, partager et participer autour de la data, de l'IA et des technologies, à Douala et en ligne."
  jsonLd={jsonLd}
>
  <section class="border-b border-gemula-silver">
    <div class="container-g pt-10 md:pt-14 pb-14 md:pb-20">
      <Breadcrumb items={[{ href: '/', label: 'Accueil' }, { label: 'Communauté' }]} class="mb-10" />
      <div class="max-w-3xl">
        <p class="eyebrow mb-5">Gemula Community</p>
        <h1 class="font-display text-display-md md:text-display-lg font-semibold tracking-tightest text-balance">
          Apprenons, partageons et construisons ensemble.
        </h1>
        <p class="mt-6 text-lg text-gemula-grey leading-relaxed max-w-2xl">
          Une communauté ouverte et gratuite pour les étudiants et passionnés de data, d'IA et de technologie. Il n'est pas nécessaire d'intégrer l'équipe pour participer.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#rejoindre" class="btn-primary">Rejoindre la communauté</a>
          {whatsappUrl && (
            <a href={whatsappUrl} target="_blank" rel="noopener" class="btn-ghost">Suivre la chaîne WhatsApp</a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- 4 ESPACES -->
  <section class="container-g section">
    <h2 class="font-display text-display-sm font-semibold tracking-tightest mb-10">Quatre façons de participer</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {espaces.map((e) => (
        <article class="card">
          <span class="mb-5 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-gemula-sand">
            <span class="material-symbols-outlined text-[1.35rem]" aria-hidden="true">{e.icon}</span>
          </span>
          <h3 class="font-display text-lg font-semibold">{e.fr}</h3>
          <p class="text-sm text-gemula-grey">{e.key}</p>
          <p class="mt-3 text-[0.9375rem] text-gemula-grey leading-relaxed">{e.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- FORMATIONS GRATUITES -->
  <section id="formations" class="bg-gemula-sand border-y border-gemula-silver">
    <div class="container-g section grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5">
        <h2 class="font-display text-display-sm font-semibold tracking-tightest">Des ateliers gratuits pour les membres</h2>
        <p class="mt-4 text-gemula-grey leading-relaxed">
          Le calendrier des prochaines sessions est publié ici et sur la chaîne WhatsApp. Les membres sont prévenus en premier.
        </p>
      </div>
      <div class="lg:col-span-7 grid sm:grid-cols-2 gap-5">
        <div class="card">
          <h3 class="font-display text-base font-semibold">Accès libre</h3>
          <p class="mt-2 text-[0.9375rem] text-gemula-grey leading-relaxed">Webinaires, conférences et tutoriels, ouverts sans inscription.</p>
        </div>
        <div class="card">
          <h3 class="font-display text-base font-semibold">Sur inscription</h3>
          <p class="mt-2 text-[0.9375rem] text-gemula-grey leading-relaxed">Ateliers pratiques à places limitées, ouverts à tous ou réservés aux membres.</p>
        </div>
        <div class="sm:col-span-2 rounded-xl border border-gemula-silver bg-white p-5 text-[0.9375rem] text-gemula-grey">
          Vous cherchez une formation pour les équipes de votre entreprise ? Consultez nos <a href="/formations" class="font-semibold text-gemula-black underline decoration-gemula-orange decoration-2 underline-offset-4">formations pour entreprises</a>.
        </div>
      </div>
    </div>
  </section>

  <!-- REJOINDRE -->
  <section id="rejoindre" class="container-g section">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14">
      <div class="lg:col-span-5">
        <h2 class="font-display text-display-sm font-semibold tracking-tightest">Rejoindre la communauté</h2>
        <p class="mt-4 text-gemula-grey leading-relaxed">
          Dites-nous qui vous êtes et ce qui vous intéresse. Nous vous écrivons pour la suite.
        </p>
        <p class="mt-8 text-sm text-gemula-grey leading-relaxed">
          Rejoindre la communauté n'est pas un recrutement dans l'équipe et ne garantit ni emploi, ni stage, ni place sur un projet. Pour candidater dans l'équipe, <a href="/collaborer#rejoindre" class="font-semibold text-gemula-black underline">consultez cette page</a>.
        </p>
      </div>

      <div class="lg:col-span-7">
        <form
          id="community-form"
          class="card md:p-8 space-y-5"
          data-email={site.email}
          novalidate
        >
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label for="c-nom" class="block text-sm font-medium mb-2">Nom complet <span class="text-gemula-accent">*</span></label>
              <input type="text" id="c-nom" name="nom" required class={inputClass} />
            </div>
            <div>
              <label for="c-email" class="block text-sm font-medium mb-2">Email <span class="text-gemula-accent">*</span></label>
              <input type="email" id="c-email" name="email" required class={inputClass} />
            </div>
          </div>

          <div>
            <label for="c-etab" class="block text-sm font-medium mb-2">École, entreprise ou ville</label>
            <input type="text" id="c-etab" name="organisation" class={inputClass} />
          </div>

          <fieldset>
            <legend class="block text-sm font-medium mb-3">Ce qui vous intéresse</legend>
            <div class="flex flex-wrap gap-2">
              {espaces.map((e) => (
                <label class="cursor-pointer">
                  <input type="checkbox" name="interets" value={e.key} class="peer sr-only" />
                  <span class="inline-flex items-center rounded-lg border border-gemula-black/20 px-3.5 py-2 text-sm font-medium transition-colors peer-checked:bg-gemula-black peer-checked:border-gemula-black peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-gemula-orange hover:border-gemula-black">
                    {e.fr}
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <div>
            <label for="c-msg" class="block text-sm font-medium mb-2">Message (facultatif)</label>
            <textarea id="c-msg" name="message" rows="3" class={`${inputClass} resize-y`}></textarea>
          </div>

          <button type="submit" class="btn-primary">Rejoindre la communauté</button>
          <p id="community-status" class="text-sm text-gemula-grey hidden" role="status"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('community-form') as HTMLFormElement | null;
  const status = document.getElementById('community-status');

  // Même Google Form que la page « Collaborer ».
  // « type » est envoyé avec la valeur COMMUNITY_TYPE : cette option doit exister
  // dans la liste déroulante du formulaire Google (sinon la réponse est ignorée).
  const GOOGLE_FORM_ACTION_URL =
    'https://docs.google.com/forms/d/e/1FAIpQLScOGnCs2MCGc4-_r-FKENVnrGF__dOD55k_xgT65DO-wHl1gA/formResponse';
  const FIELD_IDS = {
    nom: 'entry.1483131274',
    email: 'entry.672292509',
    organisation: 'entry.1220739448',
    type: 'entry.1070537805',
    message: 'entry.485062477'
  };
  const COMMUNITY_TYPE = 'Gemula Community';

  if (form && status) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data = new FormData(form);
      const nom = String(data.get('nom') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const organisation = String(data.get('organisation') ?? '').trim();
      const note = String(data.get('message') ?? '').trim();
      const interets = data.getAll('interets').map(String);

      if (!nom || !email || !/^\S+@\S+\.\S+$/.test(email)) {
        status.textContent = 'Indiquez votre nom et une adresse email valide.';
        status.className = 'text-sm text-red-600';
        return;
      }

      const message =
        `[Gemula Community] Intérêts : ${interets.length ? interets.join(', ') : 'non précisés'}` +
        (note ? `\n${note}` : '');

      const payload = new URLSearchParams();
      payload.append(FIELD_IDS.nom, nom);
      payload.append(FIELD_IDS.email, email);
      payload.append(FIELD_IDS.organisation, organisation);
      payload.append(FIELD_IDS.type, COMMUNITY_TYPE);
      payload.append(FIELD_IDS.message, message);

      status.textContent = 'Envoi en cours';
      status.className = 'text-sm text-gemula-grey';

      try {
        // Google Forms ne renvoie pas d'en-têtes CORS : "no-cors" envoie la requête sans lire la réponse.
        await fetch(GOOGLE_FORM_ACTION_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: payload.toString()
        });
        status.textContent = 'Inscription envoyée. Nous vous écrivons très prochainement.';
        status.className = 'text-sm text-emerald-600';
        form.reset();
      } catch {
        status.textContent = `L'envoi a échoué. Écrivez-nous à ${form.dataset.email}.`;
        status.className = 'text-sm text-red-600';
      }
    });
  }
</script>
