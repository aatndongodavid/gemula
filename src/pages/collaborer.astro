---
import PageLayout from '@layouts/PageLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import site from '@data/site.json';

const services = [
  {
    value: 'Formation des équipes',
    title: 'Former mes équipes',
    desc: 'Formations aux outils de bureau, à l\'IA, à la data et à l\'automatisation, avec audit et diagnostic offerts.'
  },
  {
    value: 'Data Analysis',
    title: 'Analyse de données',
    desc: 'Analyse de vos données existantes, tableaux de bord, indicateurs et recommandations.'
  },
  {
    value: 'Intelligence artificielle',
    title: 'Intelligence artificielle',
    desc: 'Modèles prédictifs, automatisation et IA générative appliquée à vos cas d\'usage.'
  },
  {
    value: 'Développement logiciel',
    title: 'Développement logiciel',
    desc: 'Applications desktop et web, API et outils métier sur mesure.'
  },
  {
    value: 'Prototype / MVP',
    title: 'Prototype ou MVP',
    desc: 'Un prototype fonctionnel pour tester une idée avant un investissement lourd.'
  },
  {
    value: 'Automatisation',
    title: 'Automatisation',
    desc: 'Scripts, workflows et intégrations pour supprimer les tâches répétitives.'
  },
  {
    value: 'Design & UI/UX',
    title: 'Design et UI/UX',
    desc: 'Interfaces, identités visuelles et systèmes de design.'
  },
  {
    value: 'Projet étudiant',
    title: 'Projet étudiant encadré',
    desc: 'Un projet confié au collectif, mené par des étudiants encadrés, avec un livrable concret.'
  }
];
---
<PageLayout
  title="Contactez Gemula"
  seoTitle="Contact : formation, devis ou projet data et IA · Gemula"
  description="Formation de vos équipes, analyse de données, IA ou développement : décrivez votre besoin, nous vous répondons sous 48 heures ouvrées."
  eyebrow="Entreprises, institutions et porteurs de projets"
  breadcrumb={[
    { href: '/', label: 'Accueil' },
    { label: 'Contact' }
  ]}
>
  <!-- Contact direct -->
  <section class="container-g pb-12">
    <div class="grid sm:grid-cols-3 gap-px overflow-hidden rounded-xl border border-line bg-line max-w-4xl">
      <a href={site.phoneHref} class="bg-surface p-5 hover:bg-surface-2">
        <span class="text-sm text-muted">Téléphone</span>
        <span class="mt-1 block font-display text-lg font-semibold">{site.phone}</span>
      </a>
      <a href={site.whatsappFormation} target="_blank" rel="noopener" class="bg-surface p-5 hover:bg-surface-2">
        <span class="text-sm text-muted">WhatsApp</span>
        <span class="mt-1 block font-display text-lg font-semibold">Écrire un message</span>
      </a>
      <a href={`mailto:${site.email}`} class="bg-surface p-5 hover:bg-surface-2">
        <span class="text-sm text-muted">Email</span>
        <span class="mt-1 block font-display text-[0.95rem] font-semibold break-all">{site.email}</span>
      </a>
    </div>
  </section>

  <!-- Services -->
  <section class="container-g py-16 md:py-20 border-t border-line">
    <SectionHeading
      eyebrow="Ce que nous faisons"
      title="Huit façons de travailler ensemble"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      {services.map((service) => (
        <div class="card">
          <h3 class="font-display text-base font-semibold mb-2">
            {service.title}
          </h3>
          <p class="text-sm text-muted leading-relaxed">
            {service.desc}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Formulaire -->
  <section id="formulaire" class="container-g py-16 md:py-20 border-t border-line">
    <SectionHeading
      eyebrow="Proposer un projet"
      title="Décrivez votre besoin"
      description="Nous vous répondons sous 48 heures ouvrées. Pour une formation, précisez le nombre de personnes à former et les outils utilisés."
    />

    <form id="contact-form" class="card max-w-2xl space-y-5 md:p-8" novalidate>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        <div data-field>
          <label for="nom" class="mb-2 block text-sm font-medium">Nom complet <span class="text-accent-text" aria-hidden="true">*</span></label>
          <input type="text" id="nom" name="nom" required minlength="2" maxlength="120" autocomplete="name" class="field" />
        </div>
        <div data-field>
          <label for="email" class="mb-2 block text-sm font-medium">Email professionnel <span class="text-accent-text" aria-hidden="true">*</span></label>
          <input type="email" id="email" name="email" required maxlength="160" autocomplete="email" inputmode="email" class="field" placeholder="nom@entreprise.cm" />
        </div>
      </div>

      <div data-field>
        <label for="organisation" class="mb-2 block text-sm font-medium">Entreprise ou organisation</label>
        <input type="text" id="organisation" name="organisation" maxlength="160" autocomplete="organization" class="field" />
      </div>

      <div data-field>
        <label for="type" class="mb-2 block text-sm font-medium">Type de demande <span class="text-accent-text" aria-hidden="true">*</span></label>
        <select id="type" name="type" required class="field">
          <option value="">Choisir un type de demande</option>
          {services.map((s) => (
            <option value={s.value}>{s.title}</option>
          ))}
        </select>
      </div>

      <div data-field>
        <label for="message" class="mb-2 block text-sm font-medium">Décrivez votre besoin <span class="text-accent-text" aria-hidden="true">*</span></label>
        <textarea id="message" name="message" rows="6" required minlength="20" maxlength="3000" class="field resize-y" placeholder="Contexte, objectif, nombre de personnes à former, délais…"></textarea>
      </div>

      <!-- Champ piège pour les robots : invisible et ignoré par les lecteurs d'écran -->
      <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
        <label for="site_web">Ne pas remplir ce champ</label>
        <input type="text" id="site_web" name="site_web" tabindex="-1" autocomplete="off" data-hp />
      </div>

      <div data-field>
        <label class="flex items-start gap-3 text-sm text-muted">
          <input type="checkbox" id="consent" name="consent" required class="mt-0.5 h-5 w-5 shrink-0 accent-[#FF5000]" />
          <span>J'accepte que Gemula utilise ces informations pour répondre à ma demande, comme décrit dans la <a href="/confidentialite" class="text-fg underline decoration-accent underline-offset-4">politique de confidentialité</a>.</span>
        </label>
      </div>

      <div class="flex flex-wrap items-center gap-4 pt-1">
        <button type="submit" class="btn-primary">Envoyer la demande</button>
        <p class="text-sm text-muted">
          Ou écrivez à <a href={`mailto:${site.email}`} class="font-medium text-fg underline decoration-accent decoration-2 underline-offset-4">{site.email}</a>
        </p>
      </div>

      <p id="form-status" class="text-sm text-muted" role="status" aria-live="polite" hidden></p>
    </form>
  </section>

  <!-- Rejoindre Gemula -->
  <section id="rejoindre" class="container-g py-16 md:py-20 border-t border-line">
    <SectionHeading
      eyebrow="Rejoindre Gemula"
      title="Vous souhaitez rejoindre Gemula ?"
      description="Pour simplement apprendre, partager et participer, rejoignez Gemula Community. Pour intégrer l'équipe opérationnelle, nous étudions les candidatures de profils techniques, créatifs et ingénieurs lorsque des responsabilités sont disponibles."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 max-w-3xl">
      <div>
        <h3 class="font-display text-lg font-semibold mb-4">
          Ce que nous offrons
        </h3>
        <ul class="space-y-3 text-sm text-muted leading-relaxed">
          <li class="flex gap-3">
            <span class="mt-[0.55em] h-1.5 w-1.5 shrink-0 bg-accent" aria-hidden="true"></span>
            Des projets concrets qui enrichissent votre portfolio
          </li>
          <li class="flex gap-3">
            <span class="mt-[0.55em] h-1.5 w-1.5 shrink-0 bg-accent" aria-hidden="true"></span>
            Un encadrement par des pairs et par le lead du collectif
          </li>
          <li class="flex gap-3">
            <span class="mt-[0.55em] h-1.5 w-1.5 shrink-0 bg-accent" aria-hidden="true"></span>
            Une visibilité via le journal et les événements
          </li>
          <li class="flex gap-3">
            <span class="mt-[0.55em] h-1.5 w-1.5 shrink-0 bg-accent" aria-hidden="true"></span>
            Un réseau actif au Cameroun et à l'international
          </li>
        </ul>
      </div>

      <div>
        <h3 class="font-display text-lg font-semibold mb-4">
          Ce que nous demandons
        </h3>
        <ul class="space-y-3 text-sm text-muted leading-relaxed">
          <li class="flex gap-3">
            <span class="mt-[0.55em] h-1.5 w-1.5 shrink-0 bg-accent" aria-hidden="true"></span>
            Curiosité et envie d'apprendre
          </li>
          <li class="flex gap-3">
            <span class="mt-[0.55em] h-1.5 w-1.5 shrink-0 bg-accent" aria-hidden="true"></span>
            Capacité à travailler en équipe
          </li>
          <li class="flex gap-3">
            <span class="mt-[0.55em] h-1.5 w-1.5 shrink-0 bg-accent" aria-hidden="true"></span>
            Un minimum de disponibilité (5 à 10 h par semaine)
          </li>
          <li class="flex gap-3">
            <span class="mt-[0.55em] h-1.5 w-1.5 shrink-0 bg-accent" aria-hidden="true"></span>
            Une spécialité à apporter au collectif
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10">
      <a href={`mailto:${site.email}?subject=Candidature%20Gemula`} class="btn-primary">
        Envoyer une candidature
      </a>
      <a href="/communaute#rejoindre" class="btn-ghost ml-3">
        Rejoindre la communauté
      </a>
    </div>
  </section>
</PageLayout>

<script>
  import { setupForm } from '@scripts/forms';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  // Préremplissage depuis la page Formations : ?type=formation&parcours=finance
  const params = new URLSearchParams(location.search);
  const typeSelect = document.getElementById('type') as HTMLSelectElement | null;
  const messageField = document.getElementById('message') as HTMLTextAreaElement | null;
  if (params.get('type') === 'formation' && typeSelect) {
    typeSelect.value = 'Formation des équipes';
    const parcours = params.get('parcours');
    const labels: Record<string, string> = {
      assistanat: 'Assistanat et secrétariat',
      finance: 'Gestion, finance et comptabilité',
      commercial: 'Commercial et relation client',
      rh: 'Ressources humaines',
      direction: 'Managers et direction',
      pme: 'Transformation numérique des PME',
      ong: 'ONG et projets de développement'
    };
    if (messageField && !messageField.value) {
      messageField.value =
        (parcours && labels[parcours] ? `Parcours qui nous intéresse : ${labels[parcours]}\n` : '') +
        'Nombre de personnes à former : \nOutils utilisés : ';
    }
  }

  if (form && status) {
    setupForm(form, {
      status,
      fallbackEmail: 'meilleurd2001@gmail.com',
      success: 'Merci, votre demande est bien envoyée. Nous vous répondons sous 48 heures ouvrées.',
      payload: (d) => ({
        nom: String(d.get('nom') ?? '').trim(),
        email: String(d.get('email') ?? '').trim(),
        organisation: String(d.get('organisation') ?? '').trim(),
        type: String(d.get('type') ?? '').trim(),
        message: String(d.get('message') ?? '').trim()
      })
    });
  }
</script>
