---
import BaseLayout from '@layouts/BaseLayout.astro';
import Logo from '@components/Logo.astro';
import Icon from '@components/Icon.astro';

const pistes = [
  { href: '/formations', label: 'Formations pour entreprises', desc: '17 modules, 7 parcours par métier', icon: 'school' },
  { href: '/communaute', label: 'Gemula Community', desc: 'Ateliers gratuits et entraide', icon: 'users' },
  { href: '/projet', label: 'Réalisations', desc: 'Dataikos Atlas et nos autres projets', icon: 'layers' },
  { href: '/collaborer', label: 'Nous contacter', desc: 'Réponse sous 48 heures ouvrées', icon: 'mail' }
];
---
<BaseLayout
  title="Page introuvable · Gemula"
  description="La page que vous cherchez n'existe pas ou a été déplacée."
  noindex={true}
>
  <section class="relative isolate overflow-hidden">
    <div class="glow-top absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="grid-bg absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="container-g py-20 md:py-32 text-center">
      <div class="flex justify-center" aria-hidden="true">
        <Logo size="xl" alt="" class="lost-logo" />
      </div>
      <p class="mt-8 font-mono text-sm text-accent-text">Erreur 404</p>
      <h1 class="mx-auto mt-3 max-w-2xl text-display-md text-gradient text-balance">Cette page s'est perdue en route.</h1>
      <p class="mx-auto mt-5 max-w-xl text-lg text-muted">
        Elle a peut-être été déplacée ou renommée. Voici où reprendre la course.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-primary"><Icon name="home" /> Retour à l'accueil</a>
        <a href="/collaborer" class="btn-ghost">Signaler un lien cassé</a>
      </div>

      <ul class="mx-auto mt-16 grid max-w-4xl gap-3 text-left sm:grid-cols-2">
        {pistes.map((p) => (
          <li>
            <a href={p.href} class="card card-hover group flex items-center gap-4 !p-5">
              <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-line bg-surface-2 text-accent-text"><Icon name={p.icon} class="text-xl" /></span>
              <span class="flex-grow">
                <span class="block font-medium text-fg">{p.label}</span>
                <span class="block text-sm text-muted">{p.desc}</span>
              </span>
              <Icon name="arrow_forward" class="text-muted transition-transform group-hover:translate-x-0.5" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Le logo flotte doucement, comme un drapeau égaré */
  .lost-logo { animation: lost-float 4s ease-in-out infinite; transform-origin: 50% 80%; }
  @keyframes lost-float {
    0%, 100% { transform: translateY(0) rotate(-1.5deg); }
    50% { transform: translateY(-10px) rotate(1.5deg); }
  }
  @media (prefers-reduced-motion: reduce) { .lost-logo { animation: none; } }
</style>
