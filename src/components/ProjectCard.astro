---
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';

interface Props {
  project: CollectionEntry<'projets'>;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { data, slug } = project;

const statusLabels: Record<string, string> = {
  'en-cours': 'En cours',
  'realise': 'Réalisé',
  'experimental': 'Expérimental',
  'concept': 'Concept'
};
---
<article class={`card card-hover reveal h-full flex flex-col ${featured ? 'md:p-10' : ''}`}>
  <div class="flex items-start justify-between gap-4 mb-5">
    <span class="tag">{statusLabels[data.status] ?? data.status}</span>
    {data.year && (
      <span class="text-xs text-gemula-grey">{data.year}</span>
    )}
  </div>

  <h3 class={`font-display font-semibold mb-2 ${featured ? 'text-2xl md:text-3xl' : 'text-xl'}`}>
    {data.title}
  </h3>

  <p class="text-sm text-gemula-orange font-medium mb-4">
    {data.tagline}
  </p>

  {!featured && (
    <p class="text-sm text-gemula-grey leading-relaxed mb-6 flex-grow">
      {data.solution.length > 140
        ? data.solution.slice(0, 140).trim() + '…'
        : data.solution}
    </p>
  )}

  {featured && (
    <p class="text-base text-gemula-grey leading-relaxed mb-6 flex-grow">
      {data.solution}
    </p>
  )}

  <TagList tags={data.stack.slice(0, 4)} class="mb-6" />

  <a
    href={`/projets/${slug}`}
    class="inline-flex items-center gap-2 text-sm font-medium text-gemula-black hover:text-gemula-orange transition-colors"
  >
    Voir le projet
    <span class="material-symbols-outlined text-[1.1em]" aria-hidden="true">arrow_forward</span>
  </a>
</article>