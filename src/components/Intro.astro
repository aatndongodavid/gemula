---
// Écran d'ouverture avec le logo officiel de Gemula : le drapeau se déploie, puis le nom apparaît.
// Les deux images sont des découpes exactes du logo : superposées, elles le reconstituent à l'identique.
// Joué une seule fois par session, jamais si le visiteur limite les animations ; un clic le passe.
---
<div id="intro" aria-hidden="true">
  <div class="intro-logo">
    <img class="intro-flag" src="/images/brand/gemula-logo-drapeau.webp" alt="" width="600" height="260" decoding="sync" fetchpriority="high" />
    <img class="intro-name" src="/images/brand/gemula-logo-nom.webp" alt="" width="600" height="125" decoding="sync" fetchpriority="high" />
  </div>
</div>

<script>
  const intro = document.getElementById('intro');
  const root = document.documentElement;
  if (intro && root.classList.contains('intro')) {
    const finish = () => {
      intro.classList.add('is-done');
      try { sessionStorage.setItem('gemula-intro', '1'); } catch {}
      setTimeout(() => root.classList.remove('intro'), 650);
    };
    setTimeout(finish, 2300);
    intro.addEventListener('click', finish, { once: true });
  }
</script>
