---
import Flag from './Flag.astro';
import site from '@data/site.json';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Entreprises',
    links: [
      { href: '/formations', label: 'Formations' },
      { href: '/formations#parcours', label: 'Parcours par métier' },
      { href: '/expertise', label: 'Expertise' },
      { href: '/projet', label: 'Réalisations' },
      { href: '/collaborer', label: 'Demander un devis' }
    ]
  },
  {
    title: 'Le collectif',
    links: [
      { href: '/talents', label: 'Équipe' },
      { href: '/journal', label: 'Journal' },
      { href: '/agenda-scientifique', label: 'Agenda scientifique' },
      { href: '/communaute', label: 'Gemula Community' },
      { href: '/collaborer#rejoindre', label: "Rejoindre l'équipe" }
    ]
  }
];
---
<footer class="bg-gemula-black text-white">
  <div class="checker-band" aria-hidden="true"></div>
  <div class="container-g py-14 md:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-10">
      <div class="lg:col-span-4">
        <div class="flex items-center gap-3 mb-5">
          <Flag size="md" variant="light" />
          <span class="font-display text-xl font-semibold tracking-tightest">Gemula</span>
        </div>
        <p class="text-[0.9375rem] text-white/70 leading-relaxed max-w-xs">
          Collectif d'ingénierie en data, intelligence artificielle et logiciel, basé à Douala, Cameroun.
        </p>
      </div>

      {columns.map((col) => (
        <div class="lg:col-span-2">
          <h3 class="text-sm font-semibold text-white mb-4">{col.title}</h3>
          <ul class="flex flex-col gap-2.5">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="text-[0.9375rem] text-white/70 hover:text-white transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="lg:col-span-4">
        <h3 class="text-sm font-semibold text-white mb-4">Contact</h3>
        <ul class="flex flex-col gap-2.5 text-[0.9375rem]">
          <li>
            <a href={site.phoneHref} class="text-white/70 hover:text-white transition-colors">{site.phone}</a>
          </li>
          <li>
            <a href={site.whatsapp} target="_blank" rel="noopener" class="text-white/70 hover:text-white transition-colors">WhatsApp</a>
          </li>
          <li>
            <a href={`mailto:${site.email}`} class="text-white/70 hover:text-white transition-colors break-all">{site.email}</a>
          </li>
          <li class="flex gap-4 pt-1">
            <a href={site.social.linkedin} target="_blank" rel="noopener" class="text-white/70 hover:text-white transition-colors">LinkedIn</a>
            <a href={site.social.github} target="_blank" rel="noopener" class="text-white/70 hover:text-white transition-colors">GitHub</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col md:flex-row justify-between gap-3 text-sm text-white/50">
      <p>© {year} {site.name}. Tous droits réservés.</p>
      <p>{site.tagline}</p>
    </div>
  </div>
</footer>
