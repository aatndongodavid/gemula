---
import Logo from './Logo.astro';
import site from '@data/site.json';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Entreprises',
    links: [
      { href: '/formations', label: 'Formations' },
      { href: '/formations#parcours', label: 'Parcours par métier' },
      { href: '/expertise', label: 'Solutions sur mesure' },
      { href: '/projet', label: 'Réalisations' },
      { href: '/collaborer', label: 'Demander un devis' }
    ]
  },
  {
    title: 'Communauté',
    links: [
      { href: '/communaute', label: 'Gemula Community' },
      { href: '/communaute#formations', label: 'Ateliers gratuits' },
      { href: '/communaute#rejoindre', label: 'Rejoindre la communauté' },
      { href: '/agenda-scientifique', label: 'Agenda scientifique' }
    ]
  },
  {
    title: 'Le collectif',
    links: [
      { href: '/talents', label: 'Équipe' },
      { href: '/journal', label: 'Journal' },
      { href: '/collaborer#rejoindre', label: "Rejoindre l'équipe" }
    ]
  }
];

const legal = [
  { href: '/confidentialite', label: 'Confidentialité' },
  { href: '/conditions', label: "Conditions d'utilisation" },
  { href: '/mentions-legales', label: 'Mentions légales' }
];
---
<footer class="border-t border-line bg-bg">
  <div class="container-g py-16 md:py-20">
    <div class="grid grid-cols-2 gap-10 lg:grid-cols-12">
      <div class="col-span-2 lg:col-span-4">
        <Logo />
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-muted">
          Collectif d'innovation technologique en data, intelligence artificielle et logiciel. Douala, Cameroun.
        </p>
        <ul class="mt-6 flex flex-col gap-2 text-sm">
          <li><a href={site.phoneHref} class="text-muted hover:text-fg">{site.phone}</a></li>
          <li><a href={site.whatsapp} target="_blank" rel="noopener" class="text-muted hover:text-fg">WhatsApp</a></li>
          <li><a href={`mailto:${site.email}`} class="break-all text-muted hover:text-fg">{site.email}</a></li>
        </ul>
      </div>

      {columns.map((col) => (
        <div class="lg:col-span-2">
          <h2 class="mb-4 text-sm font-medium text-fg">{col.title}</h2>
          <ul class="flex flex-col gap-2.5">
            {col.links.map((link) => (
              <li><a href={link.href} class="text-sm text-muted transition-colors hover:text-fg">{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}

      <div class="lg:col-span-2">
        <h2 class="mb-4 text-sm font-medium text-fg">Suivre Gemula</h2>
        <ul class="flex flex-col gap-2.5 text-sm">
          <li><a href={site.social.linkedin} target="_blank" rel="noopener" class="text-muted hover:text-fg">LinkedIn</a></li>
          <li><a href={site.social.github} target="_blank" rel="noopener" class="text-muted hover:text-fg">GitHub</a></li>
          <li><a href={site.community.whatsappUrl} target="_blank" rel="noopener" class="text-muted hover:text-fg">Chaîne WhatsApp</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-line pt-6 text-sm text-muted md:flex-row md:items-center md:justify-between">
      <p>© {year} {site.name}. {site.tagline}</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {legal.map((l) => <li><a href={l.href} class="hover:text-fg">{l.label}</a></li>)}
        <li><a href="/confidentialite#cookies" data-open-consent class="hover:text-fg">Gérer les cookies</a></li>
      </ul>
    </div>
  </div>
</footer>
