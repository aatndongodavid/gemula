---
import Flag from './Flag.astro';

const links = [
  { href: '/formations', label: 'Formations' },
  { href: '/expertise',  label: 'Expertise' },
  { href: '/projet',     label: 'Réalisations' },
  { href: '/talents',    label: 'Équipe' },
  { href: '/journal',    label: 'Journal' },
  { href: '/communaute', label: 'Communauté' }
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  if (href === '/projet') return currentPath === '/projet' || currentPath.startsWith('/projets');
  return currentPath === href || currentPath.startsWith(href + '/');
}
---
<header id="nav" class="fixed inset-x-0 top-0 z-50 bg-white/95 backdrop-blur border-b border-gemula-silver">
  <div class="container-g flex h-16 md:h-[72px] items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3" aria-label="Gemula, retour à l'accueil">
      <Flag size="md" />
      <span class="font-display text-[1.35rem] font-semibold tracking-tightest text-gemula-black">Gemula</span>
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Navigation principale">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class={`rounded-md px-3 py-2 text-[0.9375rem] font-medium transition-colors ${
            isActive(link.href)
              ? 'text-gemula-black bg-gemula-sand'
              : 'text-gemula-grey hover:text-gemula-black'
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href="/collaborer" class="hidden sm:inline-flex btn-primary py-2.5 px-4 text-sm">
        Nous contacter
      </a>
      <button
        id="burger"
        class="lg:hidden inline-flex h-10 w-10 items-center justify-center rounded-md border border-gemula-silver"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-panel"
      >
        <span class="material-symbols-outlined text-[1.4rem]" aria-hidden="true">menu</span>
      </button>
    </div>
  </div>

  <div
    id="mobile-panel"
    class="lg:hidden overflow-hidden max-h-0 transition-[max-height] duration-200 ease-out bg-white"
  >
    <nav class="container-g py-3 flex flex-col border-t border-gemula-silver" aria-label="Navigation mobile">
      {links.map((link) => (
        <a
          href={link.href}
          class={`py-3 text-base font-medium border-b border-gemula-silver/70 ${
            isActive(link.href) ? 'text-gemula-accent' : 'text-gemula-black'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a href="/collaborer" class="btn-primary mt-4 mb-2">Nous contacter</a>
    </nav>
  </div>
</header>
