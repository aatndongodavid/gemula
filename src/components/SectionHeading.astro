---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  link?: { href: string; label: string };
  align?: 'left' | 'center';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  link,
  align = 'left',
  class: className = ''
} = Astro.props;

const alignment = align === 'center' ? 'text-center items-center' : 'text-left items-start';
---
<div class={`flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16 ${className}`}>
  <div class={`max-w-3xl flex flex-col ${alignment}`}>
    {eyebrow && <span class="eyebrow mb-4">{eyebrow}</span>}
    <h2 class="font-display text-display-sm md:text-display-md font-bold tracking-tightest text-balance">
      {title}
    </h2>
    {description && (
      <p class="mt-5 text-base md:text-lg text-gemula-grey leading-relaxed max-w-2xl">
        {description}
      </p>
    )}
  </div>

  {link && (
    <a
      href={link.href}
      class="hidden md:inline-flex items-center gap-2 text-sm font-medium text-gemula-grey hover:text-gemula-orange transition-colors shrink-0"
    >
      {link.label}
      <span class="material-symbols-outlined text-[1.1em]" aria-hidden="true">arrow_forward</span>
    </a>
  )}
</div>