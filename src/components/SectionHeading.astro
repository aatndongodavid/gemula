---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  link?: { href: string; label: string };
  align?: 'left' | 'center';
  class?: string;
  as?: 'h2' | 'h3';
}

const {
  eyebrow,
  title,
  description,
  link,
  align = 'left',
  class: className = ''
} = Astro.props;

const alignment = align === 'center' ? 'text-center items-center mx-auto' : 'text-left items-start';
---
<div class={`flex flex-col md:flex-row md:items-end md:justify-between gap-5 mb-10 md:mb-12 ${className}`}>
  <div class={`max-w-2xl flex flex-col ${alignment}`}>
    {eyebrow && <span class="eyebrow mb-3">{eyebrow}</span>}
    <h2 class="font-display text-display-sm font-semibold tracking-tightest text-balance">
      {title}
    </h2>
    {description && (
      <p class="mt-4 text-base md:text-lg text-gemula-grey leading-relaxed">
        {description}
      </p>
    )}
  </div>

  {link && (
    <a href={link.href} class="link-arrow text-[0.9375rem] shrink-0">
      {link.label}
    </a>
  )}
</div>
