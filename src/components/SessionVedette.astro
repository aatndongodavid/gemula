---
// Annonce de la prochaine formation de Gemula Community (données : src/data/communaute.json).
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import { dateLongue, libelleStatut, type Session, type Statut } from '@lib/sessions';

interface Props {
  session: Session & { statut: Statut };
  /** « complet » : page Communauté ; « compact » : page d'accueil */
  variante?: 'complet' | 'compact';
}

const { session: s, variante = 'complet' } = Astro.props;
const formateur = s.formateur ? await getEntry('talents', s.formateur) : undefined;
const affiche = s.affiches?.[0];
const ouverte = s.statut === 'ouverte';
---
<article class="relative isolate overflow-hidden rounded-3xl border border-accent/40 bg-surface" data-reveal>
  <div class="glow-top absolute inset-0 -z-10 opacity-70" aria-hidden="true"></div>
  <div class="grid lg:grid-cols-12">
    <div class="flex flex-col p-6 md:p-10 lg:col-span-7">
      <div class="flex flex-wrap items-center gap-2">
        <span class="pill !border-accent/50 !text-fg"><span class={`h-1.5 w-1.5 rounded-full ${ouverte ? 'bg-success' : 'bg-accent'}`} aria-hidden="true"></span>{libelleStatut[s.statut]}</span>
        {s.acces && <span class="tag">{s.acces}</span>}
      </div>
      <h3 class="mt-5 text-2xl md:text-3xl tracking-tighter2 text-balance">{s.titre}</h3>
      {s.accroche && <p class="mt-3 text-lg text-muted">{s.accroche}</p>}

      <dl class="mt-6 grid gap-3 text-sm sm:grid-cols-2">
        {s.debut && (
          <div class="flex items-start gap-2.5"><Icon name="calendar_today" class="mt-0.5 text-accent-text" /><div><dt class="sr-only">Début</dt><dd class="text-fg">À partir du {dateLongue(s.debut)}</dd></div></div>
        )}
        {s.duree && (
          <div class="flex items-start gap-2.5"><Icon name="school" class="mt-0.5 text-accent-text" /><div><dt class="sr-only">Durée</dt><dd class="text-fg">{s.duree}</dd></div></div>
        )}
        {s.format && (
          <div class="flex items-start gap-2.5"><Icon name="explore" class="mt-0.5 text-accent-text" /><div><dt class="sr-only">Format</dt><dd class="text-fg">{s.format}</dd></div></div>
        )}
        {formateur && (
          <div class="flex items-start gap-2.5"><Icon name="users" class="mt-0.5 text-accent-text" /><div><dt class="sr-only">Formateur</dt><dd class="text-fg">Avec <a href={`/talents/${formateur.slug}`} class="underline decoration-accent underline-offset-4">{formateur.data.name}</a></dd></div></div>
        )}
      </dl>

      {variante === 'complet' && s.programme && (
        <ol class="mt-8 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2">
          {s.programme.map((m, i) => (
            <li class="bg-bg/80 p-4">
              <span class="font-mono text-xs text-accent-text">0{i + 1}</span>
              <p class="mt-1 font-medium text-fg">{m.titre}</p>
              <p class="text-sm text-muted">{m.detail}</p>
            </li>
          ))}
        </ol>
      )}

      {variante === 'complet' && s.objectifs && (
        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted">
          {s.objectifs.map((o) => <li class="flex items-center gap-2"><Icon name="check_circle" class="text-accent-text" />{o}</li>)}
        </ul>
      )}

      <div class="mt-auto flex flex-wrap gap-3 pt-8">
        {ouverte && s.inscription && (
          <a href={s.inscription} target="_blank" rel="noopener" class="btn-primary"><Icon name="chat" /> S'inscrire sur WhatsApp</a>
        )}
        {variante === 'compact' && <a href="/communaute#formations" class="btn-ghost">Voir le programme</a>}
        {variante === 'complet' && s.article && <a href={s.article} class="btn-ghost">Lire l'annonce</a>}
      </div>
      {ouverte && s.prerequis && <p class="mt-4 text-sm text-muted">{s.prerequis} Places limitées : inscrivez-vous tôt.</p>}
    </div>

    {affiche && (
      <div class="relative border-t border-line bg-bg/40 p-6 md:p-8 lg:col-span-5 lg:border-l lg:border-t-0">
        <img src={affiche.src} alt={affiche.alt} width="864" height="1080" class="mx-auto w-full max-w-sm rounded-2xl border border-line-strong shadow-glow" loading="lazy" decoding="async" />
      </div>
    )}
  </div>
</article>
