---
// Logo officiel de Gemula (image fournie, fond transparent). Ne pas redessiner : utiliser ce fichier.
interface Props {
  class?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  /** Texte alternatif ; laisser vide si un lien parent porte déjà un libellé. */
  alt?: string;
  eager?: boolean;
}

const { class: className = '', size = 'md', alt = 'Gemula', eager = false } = Astro.props;
// Proportions du logo recadré : 1480 x 950
const height = { sm: 32, md: 44, lg: 64, xl: 96 }[size];
const width = Math.round((height * 1480) / 950);
const src = size === 'xl' ? '/images/brand/gemula-logo.webp' : '/images/brand/gemula-logo-sm.webp';
---
<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  class={`block w-auto select-none ${className}`}
  style={`height:${height}px`}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  draggable="false"
/>
