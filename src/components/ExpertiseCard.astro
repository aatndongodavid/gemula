---
interface Expertise {
  slug: string;
  number: string;
  title: string;
  icon: string;
  description: string;
  tags: string[];
  href?: string;
}

interface Props {
  domain: Expertise;
}

const { domain } = Astro.props;
const Tag = domain.href ? 'a' : 'article';
---
<Tag
  href={domain.href}
  class={`card h-full flex flex-col ${domain.href ? 'card-hover border-gemula-black/30' : ''}`}
>
  <span class="mb-5 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-gemula-sand text-gemula-black">
    <span class="material-symbols-outlined text-[1.35rem]" aria-hidden="true">{domain.icon}</span>
  </span>

  <h3 class="font-display text-lg font-semibold mb-2">{domain.title}</h3>

  <p class="text-[0.9375rem] text-gemula-grey leading-relaxed flex-grow">{domain.description}</p>

  {domain.tags.length > 0 && (
    <ul class="mt-5 flex flex-wrap gap-1.5">
      {domain.tags.slice(0, 4).map((tag) => (
        <li class="tag">{tag}</li>
      ))}
    </ul>
  )}

  {domain.href && (
    <span class="link-arrow mt-6 text-[0.9375rem]">Voir les formations</span>
  )}
</Tag>
