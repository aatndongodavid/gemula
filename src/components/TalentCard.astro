---
import type { CollectionEntry } from 'astro:content';

interface Props {
  talent: CollectionEntry<'talents'>;
}

const { talent } = Astro.props;
const { data, slug } = talent;
---
<article class="card card-hover reveal h-full flex flex-col">
  <div class="flex items-center gap-4 mb-5">
    <div class="w-14 h-14 rounded-full bg-gemula-black text-gemula-orange flex items-center justify-center font-display font-bold text-sm shrink-0">
      {data.initials}
    </div>
    <div class="min-w-0">
      <h3 class="font-display font-semibold text-base leading-tight truncate">
        {data.name}
      </h3>
      <p class="text-sm text-gemula-orange font-medium truncate">
        {data.role}
      </p>
    </div>
  </div>

  {data.expertise.length > 0 && (
    <ul class="flex flex-wrap gap-1.5 mb-5">
      {data.expertise.slice(0, 3).map((skill) => (
        <li class="tag text-[0.7rem]">{skill}</li>
      ))}
    </ul>
  )}

  {data.bio && (
    <p class="text-sm text-gemula-grey leading-relaxed mb-5 flex-grow line-clamp-3">
      {data.bio}
    </p>
  )}

  <div class="flex items-center gap-4 mt-auto pt-4 border-t border-gemula-black/[0.06]">
    <a
      href={`/talents/${slug}`}
      class="text-sm font-medium text-gemula-black hover:text-gemula-orange transition-colors"
    >
      Profil
    </a>
    {data.linkedin && (
      <a
        href={data.linkedin}
        target="_blank"
        rel="noopener"
        class="text-sm text-gemula-grey hover:text-gemula-orange transition-colors"
        aria-label={`LinkedIn de ${data.name}`}
      >
        LinkedIn
      </a>
    )}
    {data.github && (
      <a
        href={data.github}
        target="_blank"
        rel="noopener"
        class="text-sm text-gemula-grey hover:text-gemula-orange transition-colors"
        aria-label={`GitHub de ${data.name}`}
      >
        GitHub
      </a>
    )}
  </div>
</article>