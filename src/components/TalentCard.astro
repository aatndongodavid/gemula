---
import type { CollectionEntry } from 'astro:content';

interface Props {
  talent: CollectionEntry<'talents'>;
  teaches?: string;
}

const { talent, teaches } = Astro.props;
const { data, slug } = talent;
---
<article class="card card-hover h-full flex flex-col">
  <div class="flex items-center gap-4 mb-5">
    {data.photo ? (
      <img
        src={data.photo}
        alt={`Portrait de ${data.name}`}
        class="w-14 h-14 rounded-full object-cover shrink-0 bg-gemula-sand"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="w-14 h-14 rounded-full bg-gemula-black text-white flex items-center justify-center font-display font-semibold text-sm shrink-0" aria-hidden="true">
        {data.initials}
      </div>
    )}
    <div class="min-w-0">
      <h3 class="font-display font-semibold text-base leading-snug">
        <a href={`/talents/${slug}`} class="hover:underline">{data.name}</a>
      </h3>
      <p class="text-sm text-gemula-grey">{data.role}</p>
    </div>
  </div>

  {teaches ? (
    <p class="text-[0.9375rem] text-gemula-black leading-relaxed flex-grow">
      <span class="font-semibold">Forme sur : </span>{teaches}
    </p>
  ) : data.expertise.length > 0 && (
    <ul class="flex flex-wrap gap-1.5 flex-grow content-start">
      {data.expertise.slice(0, 3).map((skill) => (
        <li class="tag">{skill}</li>
      ))}
    </ul>
  )}

  <div class="flex items-center gap-4 mt-5 pt-4 border-t border-gemula-silver text-sm">
    <a href={`/talents/${slug}`} class="font-semibold text-gemula-black hover:underline">Profil</a>
    {data.linkedin && (
      <a href={data.linkedin} target="_blank" rel="noopener" class="text-gemula-grey hover:text-gemula-black" aria-label={`LinkedIn de ${data.name}`}>LinkedIn</a>
    )}
    {data.github && (
      <a href={data.github} target="_blank" rel="noopener" class="text-gemula-grey hover:text-gemula-black" aria-label={`GitHub de ${data.name}`}>GitHub</a>
    )}
  </div>
</article>
