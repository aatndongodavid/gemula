---
// Drapeau Gemula en SVG (damier qui ondule). Taille réglée par la hauteur (class="h-6").
import { flagCells, FLAG_VIEWBOX } from '@lib/flag';

interface Props {
  class?: string;
  color?: string;
  phase?: number;
}

const { class: className = 'h-6', color = '#FF5000', phase } = Astro.props;
const cells = flagCells(phase);
---
<svg class={`flag-mark w-auto ${className}`} viewBox={FLAG_VIEWBOX} fill={color} aria-hidden="true" focusable="false">
  {cells.map((d) => <path d={d} />)}
</svg>
