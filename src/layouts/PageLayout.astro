---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';

interface BreadcrumbItem {
  href?: string;
  label: string;
}

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  breadcrumb?: BreadcrumbItem[];
  jsonLd?: object | object[];
  image?: string;
}

const {
  title,
  description,
  eyebrow,
  breadcrumb,
  jsonLd,
  image
} = Astro.props;
---
<BaseLayout title={`${title} · Gemula`} description={description} image={image} jsonLd={jsonLd}>
  <section class="container-g pt-10 md:pt-14 pb-10 md:pb-14">
    {breadcrumb && breadcrumb.length > 0 && (
      <Breadcrumb items={breadcrumb} class="mb-10" />
    )}

    <div class="max-w-3xl">
      {eyebrow && <p class="eyebrow mb-5">{eyebrow}</p>}
      <h1 class="font-display text-display-md md:text-display-lg font-semibold tracking-tightest text-balance">
        {title}
      </h1>
      {description && (
        <p class="mt-6 text-lg text-gemula-grey leading-relaxed max-w-2xl">
          {description}
        </p>
      )}
    </div>
  </section>

  <slot />
</BaseLayout>